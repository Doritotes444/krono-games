# ============================================================================
# KRONO GAME STORE — Variables de Entorno Requeridas para Producción
# Copia estos valores en Supabase Secrets (Edge Functions) y js/config.js (solo llaves públicas)
# NUNCA subas llaves privadas ni service_role a repositorios públicos o JavaScript del navegador.
# ============================================================================

# 1. Supabase (Base de datos PostgreSQL + Auth + Edge Functions)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...solo_clave_publica_anon
SUPABASE_SERVICE_ROLE_KEY=eyJ...SOLO_EN_BACKEND_EDGE_FUNCTIONS

# 2. Proveedores OAuth 2.0 (configurar en Supabase Dashboard -> Authentication -> Providers)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 3. Verificación SMS Colombia (+57) (configurar en Supabase Phone Provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# 4. Pasarela de Pagos Colombia — Wompi (Visa, Mastercard, Nequi, Corresponsales)
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_SOLO_EN_BACKEND
WOMPI_INTEGRITY_SECRET=test_integrity_SOLO_EN_BACKEND
WOMPI_EVENTS_SECRET=test_events_SOLO_EN_BACKEND

# 5. PayPal (opcional para pagos en USD)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=SOLO_EN_BACKEND

# 6. Tasa de cambio referencial de respaldo para Edge Functions
KRONO_USD_TO_COP=4100
